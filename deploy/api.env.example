# Copy into authorized secret storage, never into git. SANDBOX only.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DATABASE_PATH=/var/lib/fairshare/sandbox.db
DEMO_MODE=false
PAYPAL_ENV=sandbox
# Add actual HTTPS origins and secret values privately before enabling provider.
PUBLIC_APP_ORIGIN=
PUBLIC_API_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_PAYOUTS_ELIGIBILITY_CONFIRMED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Dedicated Base64-encoded 32-byte server secret for authenticator MFA. Keep stable and backed up; MFA setup is unavailable when missing.
FAIRSHARE_MFA_ENCRYPTION_KEY=
# Read-only provider polling; never captures, dispatches or retries money writes.
PAYPAL_RECONCILIATION_ENABLED=false

# Optional local scanned-PDF OCR. Requires trusted Poppler + Tesseract (English).
LOCAL_OCR_ENABLED=false

# Hackathon-only simulated MFA. Default off; rejected in DEMO, NODE_ENV=production,
# or PAYPAL_ENV=live. Existing real authenticators are never bypassed.
# HACKATHON_MFA_SIMULATION=true
