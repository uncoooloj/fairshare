# Example only. Export variables into the API process; npm start does not load this file.
HOST=127.0.0.1
PORT=3001
DEMO_MODE=true
DATABASE_PATH=./data/fairshare-demo.db
PUBLIC_APP_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
# Never use live PayPal credentials. DEMO never enables the PayPal adapter.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_PAYOUTS_ELIGIBILITY_CONFIRMED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017
# Contract-reading fallback when Cloudflare is unset, fails or returns invalid output.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Dedicated Base64-encoded 32-byte server secret for authenticator MFA. Keep stable and backed up; MFA setup is unavailable when missing.
FAIRSHARE_MFA_ENCRYPTION_KEY=

# Optional local scanned-PDF OCR. Requires trusted Poppler + Tesseract (English).
LOCAL_OCR_ENABLED=false
