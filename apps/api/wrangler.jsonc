{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fairshare-api-sandbox",
  "main": "dist-cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "node cloudflare/build.mjs"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTHORITY",
        "class_name": "FairshareAuthority"
      },
      {
        "name": "DOCUMENT_PARSER",
        "class_name": "FairshareDocumentParser"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FairshareAuthority",
        "FairshareDocumentParser"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "FairshareDocumentParser",
      "image": "./parser-container/Dockerfile",
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "vars": {
    "OCR_ENABLED": "true",
    "HACKATHON_MFA_SIMULATION": "false",
    "PAYPAL_PAYOUTS_ENABLED": "false",
    "PAYPAL_PAYOUTS_ELIGIBILITY_CONFIRMED": "false",
    "PAYPAL_RECONCILIATION_ENABLED": "false",
    "PUBLIC_API_URL": "https://fairshare-api-sandbox.udaleamehoj.workers.dev",
    "PUBLIC_APP_ORIGIN": "https://fairshare-web.udaleamehoj.workers.dev"
  },
  "observability": {
    "enabled": false
  },
  "account_id": "5f24cf447e80f1b1b67c4c0266f91a56",
  "limits": {
    "cpu_ms": 3000
  }
}
